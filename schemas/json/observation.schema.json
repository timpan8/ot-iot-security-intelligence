{
  "$id": "https://timpan8.github.io/ot-iot-security-intelligence/schemas/observation.schema.json",
  "title": "observation",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9.]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subject_ids": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "method": {
      "type": "object",
      "properties": {
        "value": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "verified_primary",
            "corroborated_secondary",
            "needs_review",
            "unknown",
            "disputed"
          ]
        },
        "source_ids": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9.]+)*$"
          }
        },
        "reviewed_at": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "note": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "value",
        "status",
        "source_ids",
        "reviewed_at",
        "note"
      ],
      "additionalProperties": false
    },
    "period": {
      "type": "object",
      "properties": {
        "value": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "verified_primary",
            "corroborated_secondary",
            "needs_review",
            "unknown",
            "disputed"
          ]
        },
        "source_ids": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9.]+)*$"
          }
        },
        "reviewed_at": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "note": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "value",
        "status",
        "source_ids",
        "reviewed_at",
        "note"
      ],
      "additionalProperties": false
    },
    "sample_size": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "value_text": {
      "type": "string",
      "minLength": 1
    },
    "uncertainty": {
      "type": "string",
      "minLength": 1
    },
    "representative": {
      "type": "boolean",
      "const": false
    },
    "caveat": {
      "type": "string",
      "minLength": 1
    },
    "source_ids": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9.]+)*$"
      }
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "verified_primary",
        "corroborated_secondary",
        "needs_review",
        "unknown",
        "disputed"
      ]
    },
    "observed_at": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "notes": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "title",
    "subject_ids",
    "method",
    "period",
    "sample_size",
    "value_text",
    "uncertainty",
    "representative",
    "caveat",
    "source_ids",
    "verification_status",
    "observed_at",
    "notes"
  ],
  "additionalProperties": false
}
