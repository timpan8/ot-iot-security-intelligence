{
  "$id": "https://timpan8.github.io/ot-iot-security-intelligence/schemas/claim.schema.json",
  "title": "claim",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9.]+)*$"
    },
    "entity_id": {
      "type": "string",
      "minLength": 1
    },
    "field": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "verified_primary",
        "corroborated_secondary",
        "needs_review",
        "unknown",
        "disputed"
      ]
    },
    "source_ids": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9.]+)*$"
      }
    },
    "conflict_note": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "reviewed_at": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "history": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "status": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "verified_primary",
                  "corroborated_secondary",
                  "needs_review",
                  "unknown",
                  "disputed"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "date",
          "status",
          "summary"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "entity_id",
    "field",
    "text",
    "status",
    "source_ids",
    "conflict_note",
    "reviewed_at",
    "history"
  ],
  "additionalProperties": false
}
