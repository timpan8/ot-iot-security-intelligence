{
  "$id": "https://timpan8.github.io/ot-iot-security-intelligence/schemas/advisory.schema.json",
  "title": "advisory",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9.]+)*$"
    },
    "advisory_id": {
      "type": "string",
      "minLength": 1
    },
    "issuer": {
      "type": "string",
      "minLength": 1
    },
    "vendor_id": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9.]+)*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "csaf_url": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "null"
        }
      ]
    },
    "published_at": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "updated_at": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "interim",
        "final",
        "unknown"
      ]
    },
    "source_type": {
      "type": "string",
      "enum": [
        "primary_vendor",
        "primary_government",
        "primary_standard",
        "secondary_research",
        "secondary_media",
        "database",
        "internal_workbook"
      ]
    },
    "cve_ids": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^CVE-\\d{4}-\\d{4,}$"
      }
    },
    "summary": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "history": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "status": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "verified_primary",
                  "corroborated_secondary",
                  "needs_review",
                  "unknown",
                  "disputed"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "date",
          "status",
          "summary"
        ],
        "additionalProperties": false
      }
    },
    "source_ids": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9.]+)*$"
      }
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "verified_primary",
        "corroborated_secondary",
        "needs_review",
        "unknown",
        "disputed"
      ]
    },
    "review": {
      "type": "object",
      "properties": {
        "reviewed_at": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewer": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "history": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              },
              "status": {
                "default": null,
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "verified_primary",
                      "corroborated_secondary",
                      "needs_review",
                      "unknown",
                      "disputed"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "summary": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "date",
              "status",
              "summary"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "reviewed_at",
        "reviewer",
        "notes",
        "history"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "advisory_id",
    "issuer",
    "vendor_id",
    "title",
    "url",
    "csaf_url",
    "published_at",
    "updated_at",
    "status",
    "source_type",
    "cve_ids",
    "summary",
    "history",
    "source_ids",
    "verification_status",
    "review"
  ],
  "additionalProperties": false
}
