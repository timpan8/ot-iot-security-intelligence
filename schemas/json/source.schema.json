{
  "$id": "https://timpan8.github.io/ot-iot-security-intelligence/schemas/source.schema.json",
  "title": "source",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9.]+)*$"
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "source_type": {
      "type": "string",
      "enum": [
        "primary_vendor",
        "primary_government",
        "primary_standard",
        "secondary_research",
        "secondary_media",
        "database",
        "internal_workbook"
      ]
    },
    "is_primary": {
      "type": "boolean"
    },
    "published_at": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "last_checked_at": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "last_verified_at": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "availability": {
      "default": "unchecked",
      "type": "string",
      "enum": [
        "ok",
        "broken",
        "blocked",
        "redirected",
        "unchecked"
      ]
    },
    "http_status": {
      "default": null,
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "supports_claims": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "entity_id": {
            "type": "string",
            "minLength": 1
          },
          "field": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "entity_id",
          "field",
          "note"
        ],
        "additionalProperties": false
      }
    },
    "access_note": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "document_sha256": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "fetched_at": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "final_url": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "interpretation_text": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "register_source_key": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "url",
    "title",
    "publisher",
    "source_type",
    "is_primary",
    "published_at",
    "last_checked_at",
    "last_verified_at",
    "availability",
    "http_status",
    "supports_claims",
    "access_note",
    "notes",
    "document_sha256",
    "fetched_at",
    "final_url",
    "interpretation_text",
    "register_source_key"
  ],
  "additionalProperties": false
}
