{
  "name": "ot-iot-security-intelligence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OT/IoT Security Intelligence Platform – publik, källkritisk kunskapsbas för OT/IoT/ICS/BMS/SCADA (defensiv).",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run data:validate",
    "build": "tsc -b && vite build",
    "postbuild": "tsx scripts/check-artifact.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --trace off",
    "data:import": "tsx scripts/import-xlsx.ts",
    "data:build": "tsx scripts/normalize.ts",
    "data:validate": "tsx scripts/validate.ts",
    "data:schemas": "tsx scripts/emit-json-schemas.ts",
    "data:enrich": "tsx scripts/enrich/run.ts",
    "data:diff": "tsx scripts/enrich/diff.ts",
    "data:check-links": "tsx scripts/check-links.ts",
    "data:all": "npm run data:import && npm run data:build && npm run data:validate && npm run data:schemas"
  },
  "dependencies": {
    "minisearch": "^7.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fast-xml-parser": "^5.12.0",
    "fflate": "^0.8.3",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
